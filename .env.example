# Google Maps (JS API). Create a key in Google Cloud Console and enable Maps JavaScript API.
VITE_GOOGLE_MAPS_API_KEY=

# Vector map id for AdvancedMarker (demo default works for quick tests).
VITE_GOOGLE_MAP_ID=DEMO_MAP_ID

# Form handling — pick one:
# - netlify: deploy to Netlify and add a matching HTML form in the built site (or use this form as-is with name="contact")
# - formspree: set VITE_FORMSPREE_FORM_ID to your form id (the `f/xxxx` segment)
VITE_FORM_BACKEND=
VITE_FORMSPREE_FORM_ID=
